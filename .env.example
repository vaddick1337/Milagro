# .env.example — шаблон для этапа 2.
# Секреты НЕ пишутся в репозиторий. Файл заполняет владелец на сервере,
# права: chmod 600, владелец — root (или пользователь сервиса).

# --- админка ---------------------------------------------------------------
# Ключ администратора для Authorization: Bearer <token>.
# Пустое значение = админ-API выключен.
ADMIN_TOKEN=

# --- платежи (ЮKassa) ------------------------------------------------------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Режим: test — песочница, live — реальные платежи.
YOOKASSA_MODE=test

# --- уведомления в Telegram ------------------------------------------------
# Токен бота выдаёт @BotFather. Получатели (Telegram ID) задаются в админке.
TELEGRAM_BOT_TOKEN=

# --- сайт ------------------------------------------------------------------
SITE_DOMAIN=
SITE_SCHEME=https
# Часовой пояс студии, используется в checkWhen и подписях слотов.
SITE_TIMEZONE=Asia/Yekaterinburg

# --- загрузка фото ---------------------------------------------------------
UPLOAD_MAX_BYTES=9961472
UPLOAD_MAX_PIXELS=80000000

# --- почта для ПДн и обращений (этап 3) ------------------------------------
PRIVACY_EMAIL=
LEGAL_ADDRESS=

# --- база данных -----------------------------------------------------------
# Заполняется на этапе 2 при выборе хранилища.
DATABASE_URL=
